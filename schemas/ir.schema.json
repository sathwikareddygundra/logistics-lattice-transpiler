{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logistics-lattice-transpiler.local/schemas/ir.schema.json",
  "title": "Ir",
  "description": "T-14: the contract for 'what an IR document looks like', feeding Phase 8 (IR lowering) and consumed by Phase 9 (AST building). op values, and each op's params shape, must exactly match ir.grammar (T-56) -- see tests/test_ir_schema.py::test_op_enum_matches_grammar. This schema covers per-object shape only; graph-level invariants (unique node ids, edges referencing real nodes, acyclicity, join edge arity) and cross-field type checks (join key compatibility, aggregate result type, filter value type) are enforced by schemas/validate_ir.py on top of it, backed by ir.grammar.Ir.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "nodes", "edges"],
  "properties": {
    "schema_version": {
      "description": "Contract version for this document shape. Bump policy is formalized in T-16.",
      "type": "string",
      "const": "1.0.0"
    },
    "trace_id": {
      "description": "The T-6 trace_id this query is carrying end to end.",
      "type": "string",
      "format": "uuid"
    },
    "nodes": {
      "description": "The typed operations that make up this IR document (T-57 lowers a DAG+CAG context into these).",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "description": "Directed data-flow dependencies between nodes.",
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "ir_type": {
      "type": "string",
      "enum": ["integer", "float", "string", "boolean", "date", "datetime"]
    },
    "column_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table", "column", "type"],
      "properties": {
        "table": { "type": "string", "minLength": 1 },
        "column": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/ir_type" }
      }
    },
    "literal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "type"],
      "properties": {
        "value": { "type": ["string", "number", "boolean"] },
        "type": { "$ref": "#/$defs/ir_type" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "params"],
      "properties": {
        "id": {
          "description": "Unique within the ir document's nodes array.",
          "type": "string",
          "minLength": 1
        },
        "op": {
          "type": "string",
          "enum": [
            "select",
            "filter",
            "join",
            "aggregate",
            "window",
            "sort",
            "limit",
            "forecast",
            "output"
          ]
        },
        "params": {
          "description": "Shape depends on op -- see the if/then branches below.",
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "op": { "const": "select" } }, "required": ["op"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/select_params" } } }
        },
        {
          "if": { "properties": { "op": { "const": "filter" } }, "required": ["op"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/filter_params" } } }
        },
        {
          "if": { "properties": { "op": { "const": "join" } }, "required": ["op"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/join_params" } } }
        },
        {
          "if": { "properties": { "op": { "const": "aggregate" } }, "required": ["op"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/aggregate_params" } } }
        },
        {
          "if": { "properties": { "op": { "const": "window" } }, "required": ["op"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/window_params" } } }
        },
        {
          "if": { "properties": { "op": { "const": "sort" } }, "required": ["op"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/sort_params" } } }
        },
        {
          "if": { "properties": { "op": { "const": "limit" } }, "required": ["op"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/limit_params" } } }
        },
        {
          "if": { "properties": { "op": { "const": "forecast" } }, "required": ["op"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/forecast_params" } } }
        },
        {
          "if": { "properties": { "op": { "const": "output" } }, "required": ["op"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/output_params" } } }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_node", "to_node"],
      "properties": {
        "from_node": { "type": "string", "minLength": 1 },
        "to_node": { "type": "string", "minLength": 1 },
        "role": {
          "description": "Only meaningful for multi-input nodes (currently: join).",
          "type": "string",
          "enum": ["left", "right"]
        }
      }
    },
    "select_params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table", "columns"],
      "properties": {
        "table": { "type": "string", "minLength": 1 },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/column_ref" }
        }
      }
    },
    "filter_params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column", "operator", "value"],
      "properties": {
        "column": { "$ref": "#/$defs/column_ref" },
        "operator": {
          "type": "string",
          "enum": ["eq", "ne", "gt", "gte", "lt", "lte"]
        },
        "value": { "$ref": "#/$defs/literal" }
      }
    },
    "join_params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left_key", "right_key"],
      "properties": {
        "left_key": { "$ref": "#/$defs/column_ref" },
        "right_key": { "$ref": "#/$defs/column_ref" },
        "how": {
          "type": "string",
          "enum": ["inner", "left", "right", "outer"],
          "default": "inner"
        }
      }
    },
    "aggregate_params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "op", "result_type"],
      "properties": {
        "group_by": {
          "type": "array",
          "items": { "$ref": "#/$defs/column_ref" },
          "default": []
        },
        "metric": { "$ref": "#/$defs/column_ref" },
        "op": {
          "type": "string",
          "enum": ["sum", "count", "avg", "min", "max"]
        },
        "result_type": { "$ref": "#/$defs/ir_type" }
      }
    },
    "window_params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column", "granularity"],
      "properties": {
        "column": { "$ref": "#/$defs/column_ref" },
        "granularity": {
          "type": "string",
          "enum": ["day", "week", "month", "quarter", "year"]
        }
      }
    },
    "sort_params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by"],
      "properties": {
        "by": { "$ref": "#/$defs/column_ref" },
        "direction": {
          "type": "string",
          "enum": ["asc", "desc"],
          "default": "asc"
        }
      }
    },
    "limit_params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "forecast_params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "horizon"],
      "properties": {
        "metric": { "$ref": "#/$defs/column_ref" },
        "horizon": { "type": "integer", "minimum": 1 },
        "method": { "type": "string", "default": "linear" }
      }
    },
    "output_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "columns": {
          "type": "array",
          "items": { "$ref": "#/$defs/column_ref" },
          "default": []
        }
      }
    }
  }
}
